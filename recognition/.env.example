# Recognition service environment variables
# Copy this to .env and fill in your values

# API key — must match RECOG_API_KEY in the Spring Boot backend
RECOG_API_KEY=change-me-in-production

# Cosine distance threshold for SFace matching (lower = stricter)
# 0.363 is the recommended default for SFace
RECOG_MATCH_THRESHOLD=0.363

# Number of frames to analyse for blink liveness
RECOG_LIVENESS_BLINK_FRAMES=20

# Maximum request size in bytes (default 5 MB)
RECOG_MAX_IMAGE_BYTES=5242880
